# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Needed by the bootstrap
# script and by the cohort-creation server action.
SUPABASE_SERVICE_ROLE_KEY=

# Used once by `npm run bootstrap-admin` to create your one super-admin
# account. Every other person (facilitator/teacher/leadership) is created
# from inside the app by that admin — not by a script.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Where your app actually runs — used to build the link in a person's
# invite email (…/auth/set-password). Must also be added to Supabase's
# Auth → URL Configuration → Redirect URLs allowlist, or the invite link
# will fail. http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed if you want Claude to run `supabase db push` / migrations
# for you via the Supabase CLI instead of pasting SQL into the dashboard.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
